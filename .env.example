# ---------------------------------------------------------------------------
# Ashford Digital — Agency website environment variables
# Copy to `.env` for local dev (Vite reads VITE_* at build time).
# ---------------------------------------------------------------------------

# Stripe Payment Links shown to the client on the onboarding confirmation
# screen. Create them in your Stripe dashboard → Payment Links.
VITE_STRIPE_STANDARD_LINK="https://buy.stripe.com/your_standard_link"
VITE_STRIPE_PRO_LINK="https://buy.stripe.com/your_pro_link"

# ---------------------------------------------------------------------------
# Server-side (Cloudflare Pages Functions) — DO NOT prefix with VITE_.
# Set these in the Cloudflare dashboard or via `wrangler pages secret put`.
# They are listed here for reference only.
# ---------------------------------------------------------------------------
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# FROM_EMAIL="Ashford Digital <onboarding@ashforddigital.co.uk>"
# AGENCY_EMAIL="ashforddigital10@gmail.com"
# STRIPE_STANDARD_LINK="https://buy.stripe.com/your_standard_link"
# STRIPE_PRO_LINK="https://buy.stripe.com/your_pro_link"
